# Development Environment Variables

# API Keys (if needed)
# API_KEY=your_key_here

# Model Configuration
MODEL_PATH=models/brain_tumor_model_final.h5
BEST_MODEL_PATH=models/brain_tumor_model_best.h5

# Data Paths
DATA_DIR=data
TRAIN_DIR=data/Training
TEST_DIR=data/Testing

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Model Parameters
IMG_WIDTH=224
IMG_HEIGHT=224
BATCH_SIZE=32
EPOCHS=100

# Flask/Streamlit
DEBUG=False
PORT=8501
HOST=localhost

# GPU Configuration
USE_GPU=True
GPU_MEMORY_FRACTION=0.8
